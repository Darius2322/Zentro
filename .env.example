# Postgres connection string (Supabase or Neon). Use the "pooled" connection
# string for DATABASE_URL and the direct connection for DIRECT_URL if your
# provider distinguishes them (Supabase does).
DATABASE_URL="postgresql://user:password@host:5432/zentro?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/zentro?schema=public"

# 32+ byte random string used for session encryption (iron-session).
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-real-random-secret"

# 32-byte key (hex) used to encrypt external calendar OAuth tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="replace-with-a-real-random-hex-key"

# Populated once you create an OAuth client in Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application).
# GOOGLE_REDIRECT_URI must exactly match a registered redirect URI there,
# e.g. https://yourapp.com/api/auth/google/callback (or http://localhost:3000/... in dev).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
